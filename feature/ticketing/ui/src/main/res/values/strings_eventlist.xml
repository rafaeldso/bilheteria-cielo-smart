<resources>
    <!-- SCR-01 Eventos à venda (ui-spec 4.4). Nomes de mês e de dia vêm do Locale pt-BR no EventListFormats. -->
    <string name="ticketing_events_title">Eventos à venda</string>
    <string name="ticketing_events_history">Histórico de compras</string>
    <string name="ticketing_events_filter_group">Filtrar eventos por mês</string>
    <string name="ticketing_events_filter_all">Todos</string>
    <!-- %1$s = mês abreviado (Jan), %2$d = ano; só usado fora do ano corrente. -->
    <string name="ticketing_events_month_chip_format">%1$s %2$d</string>
    <!-- %1$s = mês por extenso (novembro), %2$d = ano. Cabeçalho e rótulo falado do chip. -->
    <string name="ticketing_events_month_header_format">%1$s de %2$d</string>
    <plurals name="ticketing_events_available">
        <item quantity="one">%d disponível</item>
        <item quantity="many">%d disponíveis</item>
        <item quantity="other">%d disponíveis</item>
    </plurals>
    <plurals name="ticketing_events_available_spoken">
        <item quantity="one">%d ingresso disponível</item>
        <item quantity="many">%d ingressos disponíveis</item>
        <item quantity="other">%d ingressos disponíveis</item>
    </plurals>
    <!-- %1$s = dia da semana abreviado (sáb.), %2$d = dia, %3$s = mês abreviado (nov), %4$s = hora (20:00), %5$s = local. -->
    <string name="ticketing_events_item_supporting_format">%1$s, %2$d %3$s · %4$s · %5$s</string>
    <!-- Item lido pelo TalkBack: nome, data, local, valor por ingresso, ingressos disponíveis. -->
    <string name="ticketing_events_item_a11y">%1$s, %2$s, %3$s, %4$s por ingresso, %5$s</string>
    <string name="ticketing_events_loading">Carregando eventos</string>
    <string name="ticketing_events_empty_title">Nenhum evento à venda</string>
    <string name="ticketing_events_empty_body">Eventos com data futura e ingressos disponíveis aparecem aqui.</string>
    <string name="ticketing_events_error_title">Não foi possível carregar os eventos</string>
    <string name="ticketing_events_error_body">Os dados dos eventos não puderam ser lidos. Tente de novo.</string>
</resources>
