<!-- Texts shared by more than one screen of the ticketing UI (SCR-01 to SCR-04). -->
<resources>
    <!-- Result of a sale: badge and "Status" field of the receipt, badge of the history. -->
    <string name="ticketing_status_approved">Aprovada</string>
    <string name="ticketing_status_declined">Negada</string>
    <string name="ticketing_status_cancelled">Cancelada</string>

    <string name="ticketing_common_retry">Tentar de novo</string>

    <!-- Money read aloud: "zero reais", "50 centavos", "100 reais", "100 reais e 50 centavos". -->
    <plurals name="ticketing_common_spoken_reais">
        <item quantity="one">%d real</item>
        <item quantity="other">%d reais</item>
    </plurals>
    <plurals name="ticketing_common_spoken_centavos">
        <item quantity="one">%d centavo</item>
        <item quantity="other">%d centavos</item>
    </plurals>
    <!-- %1$s = reais falados, %2$s = centavos falados. -->
    <string name="ticketing_common_spoken_reais_and_centavos">%1$s e %2$s</string>
    <!-- Zero is a rule of its own: the plural rules of pt would read "0 real". -->
    <string name="ticketing_common_spoken_zero">zero reais</string>

    <!-- Absolute date read aloud: %1$d = dia, %2$s = mês por extenso, %3$s = hora (09:00). -->
    <string name="ticketing_common_datetime_spoken">%1$d de %2$s às %3$s</string>

    <!-- Date of an event read aloud: %1$s = dia da semana por extenso, %2$d = dia, %3$s = mês por extenso, %4$s = hora falada. -->
    <string name="ticketing_common_event_date_spoken">%1$s, %2$d de %3$s, %4$s</string>
    <plurals name="ticketing_common_spoken_hour">
        <item quantity="one">à %d hora</item>
        <item quantity="other">às %d horas</item>
    </plurals>
    <plurals name="ticketing_common_spoken_hour_minutes">
        <item quantity="one">à %1$d e %2$d</item>
        <item quantity="other">às %1$d e %2$d</item>
    </plurals>
    <string name="ticketing_common_spoken_midnight">à meia-noite</string>
    <string name="ticketing_common_spoken_midnight_minutes">à meia-noite e %d</string>
</resources>
