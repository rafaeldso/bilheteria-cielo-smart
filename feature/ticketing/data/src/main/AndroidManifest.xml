<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET: the integration is a local deep link to the Cielo app (ADR-0010). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Package visibility (Android 11+): only the Cielo apps (terminal and emulator, research.md section 13). -->
    <queries>
        <package android:name="com.ads.lio.uriappclient" />
        <package android:name="br.com.cielosmart.orderservice" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="lio" />
        </intent>
    </queries>

    <application>
        <meta-data
            android:name="cs_integration_type"
            android:value="uri" />

        <!-- Receives order://response from the Cielo app. Exported by necessity: every extra is untrusted input. -->
        <activity
            android:name=".cielo.CieloCallbackActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Bilheteria.CieloCallback">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="response"
                    android:scheme="order" />
            </intent-filter>
        </activity>

        <service
            android:name=".cielo.PaymentForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
