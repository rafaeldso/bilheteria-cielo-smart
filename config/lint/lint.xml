<?xml version="1.0" encoding="UTF-8"?>
<!-- Android Lint — sensor S-08 (ADR-0003). Severidades elevadas para regras que
     protegem segurança, acessibilidade e design system. Alterações exigem aprovação. -->
<lint>
    <!-- Segurança (MASVS) -->
    <issue id="HardcodedDebugMode" severity="fatal" />
    <issue id="AllowBackup" severity="error" />
    <issue id="ExportedReceiver" severity="error" />
    <issue id="ExportedService" severity="error" />
    <issue id="ExportedContentProvider" severity="error" />
    <issue id="SetJavaScriptEnabled" severity="error" />
    <issue id="JavascriptInterface" severity="error" />
    <issue id="TrustAllX509TrustManager" severity="fatal" />
    <issue id="BadHostnameVerifier" severity="fatal" />
    <issue id="AcceptsUserCertificates" severity="error" />
    <issue id="InsecureBaseConfiguration" severity="error" />
    <issue id="UnsafeIntentLaunch" severity="error" />
    <issue id="LogConditional" severity="error" />

    <!-- Acessibilidade -->
    <issue id="ContentDescription" severity="error" />
    <issue id="ClickableViewAccessibility" severity="error" />
    <issue id="KeyboardInaccessibleWidget" severity="error" />

    <!-- Design system e i18n -->
    <issue id="HardcodedText" severity="error" />
    <issue id="MissingTranslation" severity="warning" />
    <issue id="UnusedResources" severity="warning" />

    <!-- Compose -->
    <issue id="ComposableNaming" severity="error" />
    <issue id="ModifierParameter" severity="error" />
    <issue id="StateFlowValueCalledInComposition" severity="error" />
    <issue id="CoroutineCreationDuringComposition" severity="fatal" />
    <issue id="FlowOperatorInvokedInComposition" severity="error" />
    <issue id="RememberReturnType" severity="error" />

    <!-- Código gerado não é analisado -->
    <issue id="all">
        <ignore path="**/build/**" />
        <ignore path="**/generated/**" />
    </issue>
</lint>
