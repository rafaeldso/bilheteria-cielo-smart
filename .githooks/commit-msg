#!/usr/bin/env bash
# Conventional Commits: tipo(escopo opcional): descrição
msg=$(head -1 "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,100}$'
if ! [[ "$msg" =~ $pattern ]] && ! [[ "$msg" =~ ^(Merge|Revert) ]]; then
  echo "commit-msg: use Conventional Commits, ex.: 'feat(payment): add PIX confirmation (AC-02)'" >&2
  exit 1
fi
